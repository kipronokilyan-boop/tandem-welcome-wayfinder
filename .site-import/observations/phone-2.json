  "html": "<div class=\"landing-slide slide-step-2 animate-slide\"><div class=\"slide-top-content static-content-no-scroll\"><div class=\"slide-2-heading-block\"><h2 class=\"slide-main-heading tight\" style=\"margin-top: 0.25rem;\">People Around the World</h2><p class=\"slide-main-subtext small\">Discover international members and start friendly conversations about language and culture.</p></div><div class=\"three-typing-chats-list\"><div class=\"live-typing-mini-card\"><div class=\"typing-mini-header\"><div class=\"typing-mini-user\"><img alt=\"Margaret\" class=\"typing-avatar-sm\" src=\"/images/margaret-DVHbrPNR.jpg\"><div><strong>Margaret W. \ud83c\uddfa\ud83c\uddf8</strong><span class=\"typing-status-badge online-status\">\ud83d\udfe2 Online</span></div></div><span class=\"typing-rate-tag\">USA</span></div><div class=\"typing-bubble-mini looking-bubble\"><span class=\"bubble-mode-tag\">\ud83d\udcac Looking to chat</span><span class=\"typing-msg-preview\">\u201cActive now \u00b7 Looking for someone to chat with\u201d</span></div></div><div class=\"live-typing-mini-card\"><div class=\"typing-mini-header\"><div class=\"typing-mini-user\"><img alt=\"Hans\" class=\"typing-avatar-sm\" src=\"/images/lars-BCerbjOB.jpg\"><div><strong>Hans W. \ud83c\udde9\ud83c\uddea</strong><span class=\"typing-status-badge typing-status\">\ud83d\udfe2 Typing...</span></div></div><span class=\"typing-rate-tag\">Germany</span></div><div class=\"typing-bubble-mini\"><div class=\"typing-dots-sm\"><span class=\"tdot\"></span><span class=\"tdot\"></span><span class=\"tdot\"></span></div><span class=\"typing-msg-preview\">\u201cI want to learn about your traditions &amp; local culture...\u201d</span></div></div><div class=\"live-typing-mini-card\"><div class=\"typing-mini-header\"><div class=\"typing-mini-user\"><img alt=\"Pierre\" class=\"typing-avatar-sm\" src=\"/images/pierre-C5XA8eMz.jpg\"><div><strong>Pierre D. \ud83c\uddeb\ud83c\uddf7</strong><span class=\"typing-status-badge looking-status\">\ud83d\udcac Looking to chat</span></div></div><span class=\"typing-rate-tag\">France</span></div><div class=\"typing-bubble-mini looking-bubble\"><span class=\"bubble-mode-tag\">\ud83d\udcac Looking to chat</span><span class=\"typing-msg-preview\">\u201cHello! What is your favorite traditional local food?\u201d</span></div></div></div><div class=\"single-review-card\"><div class=\"review-card-header\"><div class=\"review-sender-info\"><span class=\"reviewer-flag\">\ud83c\uddff\ud83c\udde6</span><div><strong>Davis Lerato</strong><span class=\"reviewer-city\">South African Member</span></div></div><span class=\"review-stars\">\u2605\u2605\u2605\u2605\u2605</span></div><p class=\"review-text-body\">\u201cA great platform for discovering different cultures and having interesting conversations with people from around the world.\u201d</p></div></div><div class=\"slide-bottom-content\"><div class=\"slide-pagination-dots\"><button type=\"button\" class=\"pag-dot\" aria-label=\"Slide 1\"></button><button type=\"button\" class=\"pag-dot active\" aria-label=\"Slide 2\"></button><button type=\"button\" class=\"pag-dot\" aria-label=\"Slide 3\"></button></div><button type=\"button\" class=\"slide-cta-btn primary-teal-btn\">Get Started \u2192</button></div></div>",
